# Local RAG Stack configuration
LRS_OLLAMA_HOST=http://localhost:11434
LRS_TEXT_EMBED_MODEL=qwen3-embedding:4b
LRS_VISION_EMBED_MODEL=qwen3-vl
LRS_VISION_EMBED_BACKEND=ollama
LRS_RERANK_MODEL=bge-reranker-v2-m3
LRS_RERANK_BACKEND=sentence_transformers
LRS_LLM_MODEL=qwen3-vl
LRS_VECTOR_STORE=sqlite
LRS_SQLITE_VEC_PATH=./data/lrs.vec.sqlite
LRS_EXTRACTION_ENGINE=docling
LRS_API_HOST=0.0.0.0
LRS_API_PORT=8000

