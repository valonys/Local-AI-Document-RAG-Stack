# Local RAG Stack configuration
LRS_OLLAMA_HOST=http://localhost:11434
LRS_TEXT_EMBED_MODEL=qwen3-embedding:4b
LRS_VISION_EMBED_MODEL=qwen3-vl
LRS_VISION_EMBED_BACKEND=ollama
LRS_RERANK_MODEL=bge-reranker-v2-m3
LRS_RERANK_BACKEND=sentence_transformers
LRS_LLM_MODEL=qwen3-vl
LRS_VECTOR_STORE=sqlite
LRS_SQLITE_VEC_PATH=./data/lrs.vec.sqlite
LRS_EXTRACTION_ENGINE=docling
LRS_API_HOST=0.0.0.0
LRS_API_PORT=8000

# ColQwen / late-interaction multi-vector visual retrieval
# LRS_VISION_EMBED_BACKEND=hf
# LRS_VISION_EMBED_MODEL=vidore/colqwen2-v1.0

# Tenant / auth (API wrapper)
# LRS_AUTH_REQUIRED=false
# LRS_DEFAULT_TENANT_ID=default
# LRS_TENANT_KEYS_JSON='{"tenant-a-key":"tenant-a","tenant-b-key":"tenant-b"}'
# LRS_TENANT_KEYS_FILE=./config/tenant_keys.json
# LRS_TENANTS_FILE=./config/tenants.json

# Docker / container defaults
# These are pre-set in the Dockerfile and docker-compose.yml. Override here
# only if you run the container manually with `docker run`.
# LRS_OLLAMA_HOST=http://ollama:11434
# LRS_EXTRACTION_ENGINE=plaintext
# LRS_DATA_DIR=/app/data
# LRS_SQLITE_VEC_PATH=/app/data/lrs.vec.sqlite
# LRS_GRAPH_STORE_PATH=/app/data/lrs.graph.sqlite
